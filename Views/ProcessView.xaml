<Window x:Class="NextGenSales.Views.ProcessView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexGenSales - Process" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen" MinHeight="600" MinWidth="900"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI">

    <!-- GLOBAL RESOURCES: Defines reusable custom styles and control templates for the application -->
    <Window.Resources>

        <!-- Custom Dropdown (ComboBox) Style: Overrides the default Windows white theme with a custom dark UI -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1C2127"/>
            <Setter Property="Foreground" Value="#D3D9E0"/>
            <Setter Property="BorderBrush" Value="#2D3A46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Dropdown container border with rounded corners -->
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>

                            <!-- Toggle button to open/close the dropdown menu -->
                            <ToggleButton Name="ToggleButton" BorderThickness="0" Background="Transparent" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <!-- Custom teal vector arrow for the dropdown icon -->
                                            <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#00C896" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Displays the currently selected text inside the collapsed ComboBox -->
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="Left"/>

                            <!-- The floating popup window that contains the selectable list items -->
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#141A21" BorderBrush="#2D3A46" BorderThickness="1" CornerRadius="6" Margin="0,4,0,0" Width="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ComboBox}}}">
                                    <ScrollViewer Margin="0,5">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Style for individual items inside the ComboBox popup -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#A0ABB5"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="Border" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="4" Margin="4,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover state for list items -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2D3A46"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <!-- Active selected state for list items -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#00C896"/>
                                <Setter Property="Foreground" Value="#0B0F13"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- MAIN APPLICATION WRAPPER: Enforces rounded corners and base background for the frameless window -->
    <Border Background="#0B0F13" CornerRadius="12">
        <Grid>
            <!-- Layout Rows: Row 0 for Title Bar, Row 1 for Main Content -->
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CUSTOM TITLE BAR: Transparent background with mouse down event for window dragging -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Window_MouseDown">

                <!-- Branding Icon and Window Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock Text="💼" Foreground="#00C896" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="NexGenSales - Process Records" Foreground="#788896" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window Control Buttons (Minimize, Maximize, Close) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                    <!-- Minimize Window Button -->
                    <Button Width="45" Height="35" Content="—" FontSize="12" Foreground="#788896" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnMinimize_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A3642"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Maximize/Restore Window Button -->
                    <Button Width="45" Height="35" Content="☐" FontSize="14" Foreground="#788896" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnMaximize_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A3642"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Close Application Button -->
                    <Button Width="45" Height="35" Content="✕" FontSize="14" Foreground="#788896" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- MAIN CONTENT AREA -->
            <Grid Grid.Row="1">

                <!-- Dynamic radial gradient background for visual depth -->
                <Rectangle>
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                            <GradientStop Color="#001F17" Offset="0" />
                            <GradientStop Color="#0B0F13" Offset="1" />
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Inner Content Layout Container -->
                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Top Navigation -->
                        <RowDefinition Height="Auto"/> <!-- Section Title -->
                        <RowDefinition Height="*"/> <!-- DataGrid Table -->
                        <RowDefinition Height="Auto"/> <!-- Bottom Controls -->
                    </Grid.RowDefinitions>

                    <!-- TOP NAVIGATION BAR -->
                    <Grid Grid.Row="0" Margin="0,0,0,25">
                        <!-- Navigate Back to Home -->
                        <Button Content="&#x276E;  Home" Click="BtnHome_Click" HorizontalAlignment="Left" Width="130" Height="40" FontSize="13" Foreground="#0B0F13" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#00C896"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#00A87D"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Navigate Forward to Exports -->
                        <Button Content="Exports  &#x276F;" Click="BtnExports_Click" HorizontalAlignment="Right" Width="130" Height="40" FontSize="13" Foreground="#0B0F13" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#00C896"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#00A87D"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- VIEW TITLE -->
                    <TextBlock Grid.Row="1" Text="Record Log Details" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,15"/>

                    <!-- DATAGRID COMPONENT: Displays the processed records in a tabular format -->
                    <DataGrid Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" 
                              Background="#141A21" RowBackground="#1E262E" AlternatingRowBackground="#141A21"
                              Foreground="White" BorderBrush="#2D3A46" BorderThickness="1"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2D3A46" VerticalGridLinesBrush="Transparent"
                              HeadersVisibility="Column" RowHeight="45" Margin="0,0,0,30"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                        <!-- DataGrid Column Header Styling -->
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0B0F13"/>
                                <Setter Property="Foreground" Value="#788896"/>
                                <Setter Property="Padding" Value="15,0"/>
                                <Setter Property="Height" Value="45"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="BorderBrush" Value="#2D3A46"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <!-- DataGrid Row Hover and Selection Styling -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <!-- Hover state -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A3642"/>
                                    </Trigger>
                                    <!-- Selected state -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#002A1F"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <!-- DataGrid Cell Styling (Removes dotted focus borders and changes selected text color) -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="15,0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderThickness="0">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="#00C896"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <!-- Column Data Binding Definitions (Dynamically sized using star ratios) -->
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Record ID" Binding="{Binding RecordID}" Width="1*"/>
                            <DataGridTextColumn Header="Record Date" Binding="{Binding RecordDate}" Width="1.5*"/>
                            <DataGridTextColumn Header="Upload Date" Binding="{Binding UploadDate}" Width="1.5*"/>
                            <DataGridTextColumn Header="Process State" Binding="{Binding ProcessState}" Width="1.5*"/>
                            <DataGridTextColumn Header="Record Type" Binding="{Binding RecordType}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- BOTTOM ANALYSIS CONTROLS: Filter parameters and execution button -->
                    <Border Grid.Row="3" Background="#141A21" BorderBrush="#1E262E" BorderThickness="1" CornerRadius="12" Padding="25">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Title column -->
                                <ColumnDefinition Width="*"/> <!-- Spacer column -->
                                <ColumnDefinition Width="Auto"/> <!-- Action column -->
                            </Grid.ColumnDefinitions>

                            <!-- Analysis Section Heading -->
                            <TextBlock Grid.Column="0" Text="Analyse Records" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,25,0"/>

                            <!-- Date Range Filter -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Select Date Range" FontSize="13" FontWeight="SemiBold" Foreground="#788896" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <ComboBox Width="170" SelectedIndex="0">
                                    <ComboBoxItem Content="1 Week"/>
                                    <ComboBoxItem Content="1 Month"/>
                                    <ComboBoxItem Content="3 Months"/>
                                    <ComboBoxItem Content="6 Months"/>
                                    <ComboBoxItem Content="1 Year"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Primary Execute Analysis Button -->
                            <Button Grid.Column="2" Content="Run Analysis" Width="180" Height="45" FontSize="14" FontWeight="Bold" Foreground="#0B0F13" Cursor="Hand" Click="BtnRunAnalysis_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#00C896"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#00A87D"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>