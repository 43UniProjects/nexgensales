<Window x:Class="NexGenSales.Views.AnalyticsDashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="NexGenSales - Analytics"
        Height="800" Width="1150"
        MinWidth="950" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- ══ Chart card surface ═══════════════════════════════════════════════ -->
        <Style x:Key="ChartCard" TargetType="Border">
            <Setter Property="Background"      Value="#141A21"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="28,22"/>
            <Setter Property="Margin"          Value="0,0,0,20"/>
            <Setter Property="BorderBrush"     Value="#1E262E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.35" ShadowDepth="6"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Section index number (dim) ══════════════════════════════════════ -->
        <Style x:Key="SectionIndex" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="#3A5A3A"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="Margin"            Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ══ Chart title (teal accent) ═══════════════════════════════════════ -->
        <Style x:Key="ChartTitle" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="#00C896"/>
            <Setter Property="FontSize"          Value="15"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ══ Primary action button (teal filled) ═════════════════════════════ -->
        <Style x:Key="TealButton" TargetType="Button">
            <Setter Property="Background"      Value="#00C896"/>
            <Setter Property="Foreground"      Value="#0B0F13"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#00A87D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#009068"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Title-bar window control button (shared base) ═══════════════════ -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#788896"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Custom dark ScrollBar ════════════════════════════════════════════ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="Width"         Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#2D3A46"
                                                        CornerRadius="3"
                                                        Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

    </Window.Resources>

    <!-- ══ Root: rounded frameless border ══════════════════════════════════════ -->
    <Border Background="#0B0F13" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>  <!-- Custom title bar -->
                <RowDefinition Height="*"/>   <!-- Main content    -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════════════
                 CUSTOM TITLE BAR
                 ══════════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Window_MouseDown">

                <!-- Branding -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock Text="💼" Foreground="#00C896" FontSize="14"
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="NexGenSales - Analytics Dashboard"
                               Foreground="#788896" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Border Background="#1C2127" CornerRadius="4"
                            Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Simulation — Hardcoded Preview Data"
                                   Foreground="#4A5A6A" FontSize="10"/>
                    </Border>
                </StackPanel>

                <!-- Window controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                    <!-- Minimise -->
                    <Button Width="45" Height="35" Content="—" FontSize="12"
                            Click="BtnMinimize_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A3642"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Maximise -->
                    <Button Width="45" Height="35" Content="☐" FontSize="14"
                            Click="BtnMaximize_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A3642"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Close -->
                    <Button Width="45" Height="35" Content="✕" FontSize="14"
                            Click="BtnClose_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                </StackPanel>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════════════
                 MAIN CONTENT AREA
                 ══════════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1">

                <!-- Radial gradient background (identical to other views) -->
                <Rectangle>
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                            <GradientStop Color="#001F17" Offset="0"/>
                            <GradientStop Color="#0B0F13" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Page heading    -->
                        <RowDefinition Height="*"/>     <!-- Scrollable body -->
                        <RowDefinition Height="Auto"/>  <!-- Footer bar      -->
                    </Grid.RowDefinitions>

                    <!-- ── Page heading ──────────────────────────────────────── -->
                    <StackPanel Grid.Row="0" Margin="30,20,30,0">
                        <TextBlock Text="Analytics Dashboard"
                                   Foreground="White" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Sales simulation data — 5 analysis modules"
                                   Foreground="#788896" FontSize="13" Margin="0,4,0,0"/>
                        <!-- Teal underline accent -->
                        <Border Height="2" Background="#00C896" CornerRadius="1"
                                HorizontalAlignment="Left" Width="60" Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- ── Scrollable chart cards ─────────────────────────────── -->
                    <ScrollViewer Grid.Row="1" Margin="30,18,30,0"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!-- ── 01  Supplier Profitability ─────────────────── -->
                            <Border Style="{StaticResource ChartCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="01" Style="{StaticResource SectionIndex}"/>
                                        <TextBlock Text="Supplier Profitability"
                                                   Style="{StaticResource ChartTitle}"/>
                                    </StackPanel>

                                    <lvc:CartesianChart x:Name="SupplierChart"
                                                        Series="{Binding SupplierSeries}"
                                                        Height="220"
                                                        LegendLocation="Bottom"
                                                        Foreground="White">
                                        <lvc:CartesianChart.AxisX>
                                            <lvc:Axis Title="Profit Ratio"
                                                      LabelFormatter="{Binding PercentFormatter}"
                                                      Foreground="#788896">
                                                <lvc:Axis.Separator>
                                                    <lvc:Separator IsEnabled="False"/>
                                                </lvc:Axis.Separator>
                                            </lvc:Axis>
                                        </lvc:CartesianChart.AxisX>
                                        <lvc:CartesianChart.AxisY>
                                            <lvc:Axis Foreground="#788896" ShowLabels="False">
                                                <lvc:Axis.Separator>
                                                    <lvc:Separator Stroke="#26788896" StrokeThickness="1"/>
                                                </lvc:Axis.Separator>
                                            </lvc:Axis>
                                        </lvc:CartesianChart.AxisY>
                                    </lvc:CartesianChart>

                                    <!-- Low-margin warning -->
                                    <Border Background="#1C1208" CornerRadius="6"
                                            Padding="12,6" Margin="0,10,0,0">
                                        <TextBlock Text="{Binding LowMarginWarning}"
                                                   Foreground="#F59E0B" FontSize="12"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- ── 02  Item Velocity ──────────────────────────── -->
                            <Border Style="{StaticResource ChartCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="02" Style="{StaticResource SectionIndex}"/>
                                        <TextBlock Text="Item Velocity — Volume Ranking"
                                                   Style="{StaticResource ChartTitle}"/>
                                    </StackPanel>

                                    <lvc:CartesianChart x:Name="VelocityChart"
                                                        Series="{Binding VelocitySeries}"
                                                        Height="260"
                                                        LegendLocation="None"
                                                        Foreground="White">
                                        <lvc:CartesianChart.AxisX>
                                            <lvc:Axis Labels="{Binding VelocityLabels}"
                                                      Title="Item ID"
                                                      Foreground="#788896">
                                                <lvc:Axis.Separator>
                                                    <lvc:Separator IsEnabled="False"/>
                                                </lvc:Axis.Separator>
                                            </lvc:Axis>
                                        </lvc:CartesianChart.AxisX>
                                        <lvc:CartesianChart.AxisY>
                                            <lvc:Axis Title="Units Sold"
                                                      Foreground="#788896">
                                                <lvc:Axis.Separator>
                                                    <lvc:Separator Stroke="#26788896" StrokeThickness="1"/>
                                                </lvc:Axis.Separator>
                                            </lvc:Axis>
                                        </lvc:CartesianChart.AxisY>
                                    </lvc:CartesianChart>
                                </StackPanel>
                            </Border>

                            <!-- ── 03  Revenue Contribution ───────────────────── -->
                            <Border Style="{StaticResource ChartCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="03" Style="{StaticResource SectionIndex}"/>
                                        <TextBlock Text="Revenue Contribution by Item"
                                                   Style="{StaticResource ChartTitle}"/>
                                    </StackPanel>

                                    <lvc:PieChart x:Name="RevenueChart"
                                                  Series="{Binding RevenueSeries}"
                                                  Height="310"
                                                  LegendLocation="Right"
                                                  InnerRadius="70"
                                                  Foreground="White"/>
                                </StackPanel>
                            </Border>

                            <!-- ── 04  Revenue Trend ──────────────────────────── -->
                            <Border Style="{StaticResource ChartCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="04" Style="{StaticResource SectionIndex}"/>
                                        <TextBlock Text="Revenue Trend Analysis — 7 Days"
                                                   Style="{StaticResource ChartTitle}"/>
                                    </StackPanel>

                                    <lvc:CartesianChart x:Name="TrendChart"
                                                        Series="{Binding TrendSeries}"
                                                        Height="260"
                                                        LegendLocation="None"
                                                        Foreground="White">
                                        <lvc:CartesianChart.AxisX>
                                            <lvc:Axis Labels="{Binding TrendLabels}"
                                                      Title="Day of Week"
                                                      Foreground="#788896"/>
                                        </lvc:CartesianChart.AxisX>
                                        <lvc:CartesianChart.AxisY>
                                            <lvc:Axis Title="Revenue"
                                                      LabelFormatter="{Binding CurrencyFormatter}"
                                                      Foreground="#788896"/>
                                        </lvc:CartesianChart.AxisY>
                                    </lvc:CartesianChart>
                                </StackPanel>
                            </Border>

                            <!-- ── 05  Discount Effectiveness ─────────────────── -->
                            <Border Style="{StaticResource ChartCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="05" Style="{StaticResource SectionIndex}"/>
                                        <TextBlock Text="Discount Effectiveness"
                                                   Style="{StaticResource ChartTitle}"/>
                                    </StackPanel>

                                    <lvc:CartesianChart x:Name="DiscountChart"
                                                        Series="{Binding DiscountSeries}"
                                                        Height="240"
                                                        LegendLocation="None"
                                                        Foreground="White">
                                        <lvc:CartesianChart.AxisX>
                                            <lvc:Axis Labels="{Binding DiscountLabels}"
                                                      Title="Discount Tier"
                                                      Foreground="#788896">
                                                <lvc:Axis.Separator>
                                                    <lvc:Separator IsEnabled="False"/>
                                                </lvc:Axis.Separator>
                                            </lvc:Axis>
                                        </lvc:CartesianChart.AxisX>
                                        <lvc:CartesianChart.AxisY>
                                            <lvc:Axis Title="Effectiveness Score"
                                                      LabelFormatter="{Binding ScoreFormatter}"
                                                      Foreground="#788896">
                                                <lvc:Axis.Separator>
                                                    <lvc:Separator Stroke="#26788896" StrokeThickness="1"/>
                                                </lvc:Axis.Separator>
                                            </lvc:Axis>
                                        </lvc:CartesianChart.AxisY>
                                    </lvc:CartesianChart>

                                    <!-- Insight callout -->
                                    <Border Background="#0D1F16" CornerRadius="6"
                                            Padding="12,6" Margin="0,10,0,0">
                                        <TextBlock Text="★  10% discount yields the highest effectiveness score (89.2)"
                                                   Foreground="#00C896" FontSize="12"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Bottom scroll breathing room -->
                            <Border Height="20"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── Footer — Generate Report ──────────────────────────── -->
                    <Border Grid.Row="2" Background="#141A21"
                            BorderBrush="#1E262E" BorderThickness="0,1,0,0"
                            Padding="30,0">
                        <Grid Height="68">
                            <!-- Status indicator (left) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#00C896" Margin="0,0,8,0"/>
                                <TextBlock Text="5 analyses complete — ready for export"
                                           Foreground="#788896" FontSize="13"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Generate PDF button (right) -->
                            <Button x:Name="GenerateReportButton"
                                    Content="🖨  Generate Report"
                                    Style="{StaticResource TealButton}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Width="200" Height="44"
                                    Click="GenerateReport_Click"/>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
