<Window x:Class="NextGenSales.Views.AnalyticsDashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="NexGenSales — Analytics Dashboard"
        Width="1050" Height="760"
        MinWidth="850" MinHeight="600"
        Background="#0B1A1F"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>

        <!-- Chart card container -->
        <Style x:Key="ChartCard" TargetType="Border">
            <Setter Property="Background"     Value="#132228"/>
            <Setter Property="CornerRadius"   Value="10"/>
            <Setter Property="Padding"        Value="24,20"/>
            <Setter Property="Margin"         Value="0,0,0,18"/>
            <Setter Property="BorderBrush"    Value="#1E3540"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Section index (dim grey) -->
        <Style x:Key="SectionIndex" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#3A5A6A"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin"     Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Chart title (teal) -->
        <Style x:Key="ChartTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#00E5A0"/>
            <Setter Property="FontSize"   Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Teal action button -->
        <Style x:Key="TealButton" TargetType="Button">
            <Setter Property="Background"      Value="#00E5A0"/>
            <Setter Property="Foreground"      Value="#0B1A1F"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="28,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#00C98A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#00B07A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>   <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Scrollable charts -->
            <RowDefinition Height="68"/>   <!-- Footer / Generate Report -->
        </Grid.RowDefinitions>

        <!-- ══ Header ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#0D2030">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Analytics Dashboard"
                               Foreground="White" FontWeight="Bold" FontSize="17"/>
                    <Border Background="#1A3040" CornerRadius="4"
                            Padding="10,3" Margin="14,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="Simulation — Hardcoded Preview Data"
                                   Foreground="#8BA8B0" FontSize="11"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Scrollable Charts Area ════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="24,20,24,0">
            <StackPanel>

                <!-- ── 01 Supplier Profitability ─────────────────────────────── -->
                <Border Style="{StaticResource ChartCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="01" Style="{StaticResource SectionIndex}"/>
                            <TextBlock Text="Supplier Profitability" Style="{StaticResource ChartTitle}"/>
                        </StackPanel>

                        <lvc:CartesianChart x:Name="SupplierChart"
                                            Series="{Binding SupplierSeries}"
                                            Height="220"
                                            LegendLocation="Bottom">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Title="Profit Ratio"
                                          LabelFormatter="{Binding PercentFormatter}"
                                          Foreground="#8BA8B0"/>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Foreground="#8BA8B0" ShowLabels="False"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>

                        <TextBlock Text="{Binding LowMarginWarning}"
                                   Foreground="#FF6B35" FontSize="11"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ── 02 Item Velocity ──────────────────────────────────────── -->
                <Border Style="{StaticResource ChartCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="02" Style="{StaticResource SectionIndex}"/>
                            <TextBlock Text="Item Velocity — Volume Ranking" Style="{StaticResource ChartTitle}"/>
                        </StackPanel>

                        <lvc:CartesianChart x:Name="VelocityChart"
                                            Series="{Binding VelocitySeries}"
                                            Height="260"
                                            LegendLocation="None">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Labels="{Binding VelocityLabels}"
                                          Title="Item ID"
                                          Foreground="#8BA8B0"/>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="Units Sold" Foreground="#8BA8B0"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </StackPanel>
                </Border>

                <!-- ── 03 Revenue Contribution ──────────────────────────────── -->
                <Border Style="{StaticResource ChartCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="03" Style="{StaticResource SectionIndex}"/>
                            <TextBlock Text="Revenue Contribution by Item" Style="{StaticResource ChartTitle}"/>
                        </StackPanel>

                        <lvc:PieChart x:Name="RevenueChart"
                                      Series="{Binding RevenueSeries}"
                                      Height="310"
                                      LegendLocation="Right"
                                      InnerRadius="70"/>
                    </StackPanel>
                </Border>

                <!-- ── 04 Revenue Trend ──────────────────────────────────────── -->
                <Border Style="{StaticResource ChartCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="04" Style="{StaticResource SectionIndex}"/>
                            <TextBlock Text="Revenue Trend Analysis — 7 Days" Style="{StaticResource ChartTitle}"/>
                        </StackPanel>

                        <lvc:CartesianChart x:Name="TrendChart"
                                            Series="{Binding TrendSeries}"
                                            Height="260"
                                            LegendLocation="None">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Labels="{Binding TrendLabels}"
                                          Title="Day of Week"
                                          Foreground="#8BA8B0"/>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="Revenue"
                                          LabelFormatter="{Binding CurrencyFormatter}"
                                          Foreground="#8BA8B0"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </StackPanel>
                </Border>

                <!-- ── 05 Discount Effectiveness ────────────────────────────── -->
                <Border Style="{StaticResource ChartCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="05" Style="{StaticResource SectionIndex}"/>
                            <TextBlock Text="Discount Effectiveness" Style="{StaticResource ChartTitle}"/>
                        </StackPanel>

                        <lvc:CartesianChart x:Name="DiscountChart"
                                            Series="{Binding DiscountSeries}"
                                            Height="240"
                                            LegendLocation="None">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Labels="{Binding DiscountLabels}"
                                          Title="Discount Tier"
                                          Foreground="#8BA8B0"/>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="Effectiveness Score"
                                          LabelFormatter="{Binding ScoreFormatter}"
                                          Foreground="#8BA8B0"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>

                        <TextBlock Text="★  10% discount yields the highest effectiveness score (89.2)"
                                   Foreground="#00E5A0" FontSize="11" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Bottom scroll padding -->
                <Border Height="16"/>

            </StackPanel>
        </ScrollViewer>

        <!-- ══ Footer — Generate Report ══════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#0D2030">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#00E5A0" Margin="0,0,8,0"/>
                    <TextBlock Text="5 analyses complete — ready for export"
                               Foreground="#8BA8B0" FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="GenerateReportButton"
                        Content="🖨  Generate Report"
                        Style="{StaticResource TealButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Width="200" Height="44"
                        Click="GenerateReport_Click"/>
            </Grid>
        </Border>

    </Grid>
</Window>
