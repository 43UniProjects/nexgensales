<Window x:Class="NexGenSales.Views.AnalyticsDashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="NexGenSales - Analytics"
        Height="800" Width="1150"
        MinWidth="950" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        FontFamily="Segoe UI">

    <!-- GLOBAL RESOURCES (STYLES & THEMES) -->
    <Window.Resources>

        <!-- Global Theme Colors -->
        <lvc:ColorsCollection x:Key="ThemeColors">
            <Color>#00C896</Color>
        </lvc:ColorsCollection>

        <!-- Reusable Style for Cartesian Charts Tooltip (Charts 02, 03, 04) -->
        <Style x:Key="DarkCartesianTooltip" TargetType="lvc:DefaultTooltip">
            <Setter Property="Background" Value="#141A21"/>
            <Setter Property="BorderBrush" Value="#2D3A46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="SelectionMode" Value="OnlySender"/>
        </Style>

        <!-- Reusable ControlTemplate for Expense Category Pie Chart Tooltip (Chart 01) -->
        <ControlTemplate x:Key="PieTooltipTemplate">
            <Border Background="#141A21" BorderBrush="#2D3A46" BorderThickness="1" CornerRadius="8" Padding="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="4" Color="#0B0F13" Opacity="0.5"/>
                </Border.Effect>
                <ItemsControl ItemsSource="{Binding Data.Points}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Width="10" Height="10" Fill="{Binding Series.Fill}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Series.Title}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="Total Amount : " Foreground="#788896" FontSize="13" Width="95"/>
                                    <TextBlock Text="{Binding ChartPoint.Y, StringFormat='{}Rs. {0:N2}'}" Foreground="#00C896" FontSize="14" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="Cost Share : " Foreground="#788896" FontSize="13" Width="95"/>
                                    <TextBlock Text="{Binding ChartPoint.Participation, StringFormat='{}{0:P2}'}" Foreground="#D3D9E0" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </ControlTemplate>

        <!-- Chart Container Card Style -->
        <Style x:Key="ChartCard" TargetType="Border">
            <Setter Property="Background"      Value="#141A21"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="28,22"/>
            <Setter Property="Margin"          Value="0,0,0,20"/>
            <Setter Property="BorderBrush"     Value="#1E262E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.35" ShadowDepth="6"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Typography: Section Index (e.g., 01, 02) -->
        <Style x:Key="SectionIndex" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="#3A5A3A"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="Margin"            Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Typography: Chart Titles -->
        <Style x:Key="ChartTitle" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="#00C896"/>
            <Setter Property="FontSize"          Value="15"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Primary Action Button Style (Teal) -->
        <Style x:Key="TealButton" TargetType="Button">
            <Setter Property="Background"      Value="#00C896"/>
            <Setter Property="Foreground"      Value="#0B0F13"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#00A87D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#009068"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Bar Window Control Buttons Style -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#788896"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="Width"         Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#2D3A46" CornerRadius="3" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- General ScrollViewer Settings -->
        <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </Window.Resources>

    <!-- MAIN WINDOW BORDER & LAYOUT GRID -->
    <Border Background="#0B0F13" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- CUSTOM TITLE BAR (ROW 0) -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Window_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock Text="💼" Foreground="#00C896" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="NexGenSales - Analytics Dashboard" Foreground="#788896" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="45" Height="35" Content="—" FontSize="12" Click="BtnMinimize_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A3642"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Width="45" Height="35" Content="☐" FontSize="14" Click="BtnMaximize_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A3642"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Width="45" Height="35" Content="✕" FontSize="14" Click="BtnClose_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>


            <!-- MAIN CONTENT AREA (ROW 1) -->
            <Grid Grid.Row="1">
                <!-- Background Gradient -->
                <Rectangle>
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                            <GradientStop Color="#001F17" Offset="0"/>
                            <GradientStop Color="#0B0F13" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Dashboard Header -->
                    <StackPanel Grid.Row="0" Margin="30,20,30,0">
                        <TextBlock Text="Analytics Dashboard" Foreground="White" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="{Binding DashboardSubtitle}" Foreground="#788896" FontSize="13" Margin="0,4,0,0"/>
                        <Border Height="2" Background="#00C896" CornerRadius="1" HorizontalAlignment="Left" Width="60" Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- Scrollable Charts Container -->
                    <ScrollViewer Grid.Row="1" Margin="30,18,30,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!-- SALES DASHBOARD VISIBILITY SECTION -->
                            <StackPanel Visibility="{Binding SalesVisibility}">

                                <!-- Chart 01: Supplier Profitability -->
                                <Border Style="{StaticResource ChartCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <TextBlock Text="01" Style="{StaticResource SectionIndex}"/>
                                            <TextBlock Text="Supplier Profitability" Style="{StaticResource ChartTitle}"/>
                                        </StackPanel>
                                        <lvc:CartesianChart x:Name="SupplierChart" Series="{Binding SupplierSeries}" Height="320" LegendLocation="Bottom" Foreground="White">
                                            <lvc:CartesianChart.AxisX>
                                                <lvc:Axis Title="Profit Ratio" LabelFormatter="{Binding PercentFormatter}" Foreground="#788896">
                                                    <lvc:Axis.Separator>
                                                        <lvc:Separator IsEnabled="False"/>
                                                    </lvc:Axis.Separator>
                                                </lvc:Axis>
                                            </lvc:CartesianChart.AxisX>
                                            <lvc:CartesianChart.AxisY>
                                                <lvc:Axis Foreground="#788896" ShowLabels="False">
                                                    <lvc:Axis.Separator>
                                                        <lvc:Separator Stroke="#26788896" StrokeThickness="1"/>
                                                    </lvc:Axis.Separator>
                                                </lvc:Axis>
                                            </lvc:CartesianChart.AxisY>
                                        </lvc:CartesianChart>
                                    </StackPanel>
                                </Border>

                                <!-- Chart 02: Item Velocity - Volume Ranking -->
                                <Border Style="{StaticResource ChartCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <TextBlock Text="02" Style="{StaticResource SectionIndex}"/>
                                            <TextBlock Text="Item Velocity — Volume Ranking" Style="{StaticResource ChartTitle}"/>
                                        </StackPanel>
                                        <lvc:CartesianChart x:Name="VelocityChart" Series="{Binding VelocitySeries}" Height="320" LegendLocation="None" Foreground="White">
                                            <lvc:CartesianChart.AxisX>
                                                <lvc:Axis Labels="{Binding VelocityLabels}" Title="Item ID" Foreground="#788896">
                                                    <lvc:Axis.Separator>
                                                        <lvc:Separator IsEnabled="False"/>
                                                    </lvc:Axis.Separator>
                                                </lvc:Axis>
                                            </lvc:CartesianChart.AxisX>
                                            <lvc:CartesianChart.AxisY>
                                                <lvc:Axis Title="Units Sold" Foreground="#788896">
                                                    <lvc:Axis.Separator>
                                                        <lvc:Separator Stroke="#26788896" StrokeThickness="1"/>
                                                    </lvc:Axis.Separator>
                                                </lvc:Axis>
                                            </lvc:CartesianChart.AxisY>
                                        </lvc:CartesianChart>
                                    </StackPanel>
                                </Border>

                                <!-- Chart 03: Revenue Contribution by Item -->
                                <Border Style="{StaticResource ChartCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <TextBlock Text="03" Style="{StaticResource SectionIndex}"/>
                                            <TextBlock Text="Revenue Contribution by Item" Style="{StaticResource ChartTitle}"/>
                                        </StackPanel>
                                        <lvc:PieChart x:Name="RevenueChart" Series="{Binding RevenueSeries}" Height="400" LegendLocation="Right" InnerRadius="70" Foreground="White"/>
                                    </StackPanel>
                                </Border>

                                <!-- Chart 04: Revenue Trend Analysis -->
                                <Border Style="{StaticResource ChartCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <TextBlock Text="04" Style="{StaticResource SectionIndex}"/>
                                            <TextBlock Text="Revenue Trend Analysis — 7 Days" Style="{StaticResource ChartTitle}"/>
                                        </StackPanel>
                                        <lvc:CartesianChart x:Name="TrendChart" Series="{Binding TrendSeries}" Height="320" LegendLocation="None" Foreground="White">
                                            <lvc:CartesianChart.AxisX>
                                                <lvc:Axis Labels="{Binding TrendLabels}" Title="Day of Week" Foreground="#788896"/>
                                            </lvc:CartesianChart.AxisX>
                                            <lvc:CartesianChart.AxisY>
                                                <lvc:Axis Title="Revenue" LabelFormatter="{Binding CurrencyFormatter}" Foreground="#788896"/>
                                            </lvc:CartesianChart.AxisY>
                                        </lvc:CartesianChart>
                                    </StackPanel>
                                </Border>

                                <!-- Chart 05: Discount Effectiveness -->
                                <Border Style="{StaticResource ChartCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <TextBlock Text="05" Style="{StaticResource SectionIndex}"/>
                                            <TextBlock Text="Discount Effectiveness" Style="{StaticResource ChartTitle}"/>
                                        </StackPanel>
                                        <lvc:CartesianChart x:Name="DiscountChart" Series="{Binding DiscountSeries}" Height="320" LegendLocation="None" Foreground="White">
                                            <lvc:CartesianChart.AxisX>
                                                <lvc:Axis Labels="{Binding DiscountLabels}" Title="Discount Tier" Foreground="#788896">
                                                    <lvc:Axis.Separator>
                                                        <lvc:Separator IsEnabled="False"/>
                                                    </lvc:Axis.Separator>
                                                </lvc:Axis>
                                            </lvc:CartesianChart.AxisX>
                                            <lvc:CartesianChart.AxisY>
                                                <lvc:Axis Title="Effectiveness Score" LabelFormatter="{Binding ScoreFormatter}" Foreground="#788896">
                                                    <lvc:Axis.Separator>
                                                        <lvc:Separator Stroke="#26788896" StrokeThickness="1"/>
                                                    </lvc:Axis.Separator>
                                                </lvc:Axis>
                                            </lvc:CartesianChart.AxisY>
                                        </lvc:CartesianChart>
                                        <Border Background="#0D1F16" CornerRadius="6" Padding="12,6" Margin="0,10,0,0">
                                            <TextBlock Text="★  10% discount yields the highest effectiveness score (89.2)" Foreground="#00C896" FontSize="12"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- EXPENSES DASHBOARD VISIBILITY SECTION      -->
                            <StackPanel Visibility="{Binding ExpenseVisibility}">

                                <!-- Summary Card: Total Expenses -->
                                <Border Style="{StaticResource ChartCard}" Background="#1C2127">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Total Expenses For Period:" Style="{StaticResource ChartTitle}" FontSize="24" Margin="0,0,20,0"/>
                                        <TextBlock Text="{Binding TotalExpensesDisplay}" Foreground="White" FontSize="28" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <!-- Chart 01: Expense Category Breakdown (Pie Chart) -->
                                <Border Style="{StaticResource ChartCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <TextBlock Text="01" Style="{StaticResource SectionIndex}"/>
                                            <TextBlock Text="Expense Category Breakdown" Style="{StaticResource ChartTitle}"/>
                                        </StackPanel>

                                        <lvc:PieChart Series="{Binding ExpenseCategorySeries}" Height="350" LegendLocation="Right" InnerRadius="70" Foreground="White" Margin="10,20,10,10">
                                            <lvc:PieChart.DataTooltip>
                                                <lvc:DefaultTooltip SelectionMode="OnlySender">
                                                    <lvc:DefaultTooltip.Template>
                                                        <ControlTemplate>
                                                            <Border Background="#141A21" BorderBrush="#2D3A46" BorderThickness="1" CornerRadius="8" Padding="15">
                                                                <Border.Effect>
                                                                    <DropShadowEffect BlurRadius="10" ShadowDepth="4" Color="#0B0F13" Opacity="0.5"/>
                                                                </Border.Effect>
                                                                <ItemsControl ItemsSource="{Binding Data.Points}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel Orientation="Vertical">
                                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                                                    <Ellipse Width="10" Height="10" Fill="{Binding Series.Fill}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                                    <TextBlock Text="{Binding Series.Title}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                                                                    <TextBlock Text="Total Amount : " Foreground="#788896" FontSize="13" Width="95"/>
                                                                                    <!-- Here is the N2 change for Pie Chart -->
                                                                                    <TextBlock Text="{Binding ChartPoint.Y, StringFormat='{}Rs. {0:N2}'}" Foreground="#00C896" FontSize="14" FontWeight="Bold"/>
                                                                                </StackPanel>
                                                                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                                                                    <TextBlock Text="Cost Share : " Foreground="#788896" FontSize="13" Width="95"/>
                                                                                    <TextBlock Text="{Binding ChartPoint.Participation, StringFormat='{}{0:P2}'}" Foreground="#D3D9E0" FontSize="14" FontWeight="SemiBold"/>
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </lvc:DefaultTooltip.Template>
                                                </lvc:DefaultTooltip>
                                            </lvc:PieChart.DataTooltip>
                                        </lvc:PieChart>
                                    </StackPanel>
                                </Border>

                                <!-- Chart 02: Daily Expense Trend -->
                                <Border Style="{StaticResource ChartCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <TextBlock Text="02" Style="{StaticResource SectionIndex}"/>
                                            <TextBlock Text="Daily Expense Trend" Style="{StaticResource ChartTitle}"/>
                                        </StackPanel>
                                        <!-- Applied Colors & Inline Default Tooltip (100% Bug Free) -->
                                        <lvc:CartesianChart Series="{Binding ExpenseTrendSeries}" SeriesColors="{StaticResource ThemeColors}" Height="320" LegendLocation="None" Foreground="White">
                                            <lvc:CartesianChart.DataTooltip>
                                                <lvc:DefaultTooltip Background="#141A21" BorderBrush="#2D3A46" BorderThickness="1" Foreground="#FFFFFF" SelectionMode="OnlySender"/>
                                            </lvc:CartesianChart.DataTooltip>
                                            <lvc:CartesianChart.AxisX>
                                                <lvc:Axis Labels="{Binding ExpenseTrendLabels}" Title="Date" Foreground="#788896"/>
                                            </lvc:CartesianChart.AxisX>
                                            <lvc:CartesianChart.AxisY>
                                                <lvc:Axis Title="Amount" LabelFormatter="{Binding CurrencyFormatter}" Foreground="#788896"/>
                                            </lvc:CartesianChart.AxisY>
                                        </lvc:CartesianChart>
                                    </StackPanel>
                                </Border>

                                <!-- Chart 03: Highest Specific Expenses -->
                                <Border Style="{StaticResource ChartCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <TextBlock Text="03" Style="{StaticResource SectionIndex}"/>
                                            <TextBlock Text="Highest Specific Expenses" Style="{StaticResource ChartTitle}"/>
                                        </StackPanel>
                                        <!-- Applied Colors, Tooltip & Removed Grid Lines -->
                                        <lvc:CartesianChart Series="{Binding SpecificTypeSeries}" SeriesColors="{StaticResource ThemeColors}" Height="320" LegendLocation="None" Foreground="White">
                                            <lvc:CartesianChart.DataTooltip>
                                                <lvc:DefaultTooltip Background="#141A21" BorderBrush="#2D3A46" BorderThickness="1" Foreground="#FFFFFF" SelectionMode="OnlySender"/>
                                            </lvc:CartesianChart.DataTooltip>
                                            <lvc:CartesianChart.AxisX>
                                                <lvc:Axis Labels="{Binding SpecificTypeLabels}" Title="Expense Type" Foreground="#788896">
                                                    <lvc:Axis.Separator>
                                                        <lvc:Separator IsEnabled="False"/>
                                                    </lvc:Axis.Separator>
                                                </lvc:Axis>
                                            </lvc:CartesianChart.AxisX>
                                            <lvc:CartesianChart.AxisY>
                                                <lvc:Axis Title="Amount" LabelFormatter="{Binding CurrencyFormatter}" Foreground="#788896"/>
                                            </lvc:CartesianChart.AxisY>
                                        </lvc:CartesianChart>
                                    </StackPanel>
                                </Border>

                                <!-- Chart 04: Asset Depreciation & Maintenance Costs -->
                                <Border Style="{StaticResource ChartCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <TextBlock Text="04" Style="{StaticResource SectionIndex}"/>
                                            <TextBlock Text="Asset Depreciation &amp; Maintenance Costs" Style="{StaticResource ChartTitle}"/>
                                        </StackPanel>
                                        <!-- Applied Colors, Tooltip & Removed Grid Lines -->
                                        <lvc:CartesianChart Series="{Binding AssetMaintenanceSeries}" SeriesColors="{StaticResource ThemeColors}" Height="320" LegendLocation="None" Foreground="White">
                                            <lvc:CartesianChart.DataTooltip>
                                                <lvc:DefaultTooltip Background="#141A21" BorderBrush="#2D3A46" BorderThickness="1" Foreground="#FFFFFF" SelectionMode="OnlySender"/>
                                            </lvc:CartesianChart.DataTooltip>
                                            <lvc:CartesianChart.AxisX>
                                                <lvc:Axis Labels="{Binding AssetLabels}" Title="Asset ID" Foreground="#788896">
                                                    <lvc:Axis.Separator>
                                                        <lvc:Separator IsEnabled="False"/>
                                                    </lvc:Axis.Separator>
                                                </lvc:Axis>
                                            </lvc:CartesianChart.AxisX>
                                            <lvc:CartesianChart.AxisY>
                                                <lvc:Axis Title="Maintenance Cost" LabelFormatter="{Binding CurrencyFormatter}" Foreground="#788896"/>
                                            </lvc:CartesianChart.AxisY>
                                        </lvc:CartesianChart>
                                    </StackPanel>
                                </Border>

                                <!-- Section 05: Detected Cost Anomalies (Data Grid) -->
                                <Border Style="{StaticResource ChartCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <TextBlock Text="05" Style="{StaticResource SectionIndex}"/>
                                            <TextBlock Text="Detected Cost Anomalies (Unusual Spikes)" Style="{StaticResource ChartTitle}"/>
                                        </StackPanel>

                                        <!-- Anomalies List Header -->
                                        <Grid Margin="0,10,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="0,0,0,15">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="3*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Date" Foreground="#788896" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="Category" Foreground="#788896" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="2" Text="Description" Foreground="#788896" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="3" Text="Amount" Foreground="#788896" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <!-- Anomalies Data Binding -->
                                            <ItemsControl Grid.Row="1" ItemsSource="{Binding AnomaliesList}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#1E262E" BorderThickness="0,0,0,1" Padding="0,12">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="1.5*"/>
                                                                    <ColumnDefinition Width="2*"/>
                                                                    <ColumnDefinition Width="3*"/>
                                                                    <ColumnDefinition Width="1.5*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Date_Recorded, StringFormat={}{0:yyyy-MM-dd}}" Foreground="White"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Expense_Category}" Foreground="White"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Specific_Type}" Foreground="White"/>
                                                                <!-- Here is the N2 change for Anomaly List -->
                                                                <TextBlock Grid.Column="3" Text="{Binding Amount, StringFormat='{}Rs. {0:N2}'}" Foreground="#E81123" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Bottom Spacing for ScrollViewer -->
                            <Border Height="20"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- FOOTER SECTION (EXPORT BUTTON) -->
                    <Border Grid.Row="2" Background="#141A21" BorderBrush="#1E262E" BorderThickness="0,1,0,0" Padding="30,0">
                        <Grid Height="68">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#00C896" Margin="0,0,8,0"/>
                                <TextBlock Text="Analysis complete — ready for export" Foreground="#788896" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="GenerateReportButton" Content="🖨  Generate Report" Style="{StaticResource TealButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Width="200" Height="44" Click="GenerateReport_Click"/>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>