<Window x:Class="NextGenSales.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexGenSales - Login" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F13">

    <!-- Main layout grid containing the background and login card -->
    <Grid>

        <!-- Dynamic radial gradient background for depth -->
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.2,0.2" RadiusX="0.8" RadiusY="0.8">
                    <GradientStop Color="#002A1F" Offset="0" />
                    <GradientStop Color="#0B0F13" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Floating central login card with border styling -->
        <Border Width="420" Height="530" 
                Background="#141A21" 
                CornerRadius="16" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center">

            <!-- Shadow effect to elevate the card from the background -->
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" Color="Black" Opacity="0.5" ShadowDepth="15"/>
            </Border.Effect>

            <!-- Premium top accent line for modern UI aesthetic -->
            <Border BorderThickness="0,4,0,0" BorderBrush="#00C896" CornerRadius="16">

                <!-- Inner container with uniform padding for form elements -->
                <StackPanel Margin="45,40,45,40">

                    <!-- Typography logo with dual-tone formatting -->
                    <TextBlock HorizontalAlignment="Center" FontSize="38" FontFamily="Segoe UI" Margin="0,0,0,5">
                        <Run Text="NexGen" FontWeight="Light" Foreground="White"/>
                        <Run Text="Sales" FontWeight="Black" Foreground="#00C896"/>
                    </TextBlock>

                    <!-- Application subtitle -->
                    <TextBlock Text="Intelligent Business Companion" FontSize="13" Foreground="#5A6A7A" HorizontalAlignment="Center" Margin="0,0,0,45" />

                    <!-- Username input field and label -->
                    <TextBlock Text="USERNAME" FontSize="11" FontWeight="Bold" Foreground="#687A8C" Margin="0,0,0,8"/>
                    <TextBox Height="45" FontSize="14" Foreground="White" Background="#1E262E" BorderThickness="1" BorderBrush="#2D3A46" Padding="15,0" VerticalContentAlignment="Center" Margin="0,0,0,18">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <!-- Password input field and label -->
                    <TextBlock Text="PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#687A8C" Margin="0,0,0,8"/>
                    <PasswordBox Height="45" FontSize="14" Foreground="White" Background="#1E262E" BorderThickness="1" BorderBrush="#2D3A46" Padding="15,0" VerticalContentAlignment="Center" Margin="0,0,0,10">
                        <PasswordBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </PasswordBox.Resources>
                    </PasswordBox>

                    <!-- Password recovery link with hover state -->
                    <TextBlock Text="Forgot Password?" FontSize="12" Foreground="#788896" HorizontalAlignment="Right" Cursor="Hand" Margin="0,0,0,25">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#00C896"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Primary authentication button -->
                    <Button Content="LOGIN" Height="48" FontSize="14" FontWeight="Bold" Foreground="White" Cursor="Hand" Margin="0,0,0,15">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#00C896"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#00A87D"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Secondary registration button (Ghost style) -->
                    <Button Content="CREATE NEW ACCOUNT" Height="48" FontSize="13" FontWeight="Bold" Foreground="#00C896" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="#00C896" BorderThickness="1.5" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#002A1F"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                </StackPanel>
            </Border>
        </Border>

        <!-- Copyright footer -->
        <TextBlock Text="© 2026 NexGenSales. All rights reserved." 
                   FontSize="12" Foreground="#4A5A6A" 
                   VerticalAlignment="Bottom" HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>
    </Grid>
</Window>