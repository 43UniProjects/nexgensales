<Window x:Class="NexGenSales.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NexGenSales.ViewModels"
        Title="NexGenSales - Login" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        ResizeMode="CanResize">


    <Window.DataContext>
        <vm:LoginViewModel />
    </Window.DataContext>


    <!-- Main border to maintain rounded corners across the application -->
    <Border Background="#0B0F13" CornerRadius="12">
        <Grid>
            <!-- Define layout rows: Row 0 for title bar, Row 1 for content -->
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar area allowing window drag functionality -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Window_MouseDown">

                <!-- Application branding and visual icon -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock Text="💼" Foreground="#00C896" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="NexGenSales" Foreground="#788896" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window control buttons (Minimize, Maximize, Close) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                    <!-- Minimize window button -->
                    <Button Width="45" Height="35" Content="—" FontSize="12" Foreground="#788896" 
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="BtnMinimize_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <!-- Hover state for minimize button -->
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A3642"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Maximize or restore window button -->
                    <Button Width="45" Height="35" Content="☐" FontSize="14" Foreground="#788896" 
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="BtnMaximize_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <!-- Hover state for maximize button -->
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A3642"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Close application button -->
                    <Button Width="45" Height="35" Content="✕" FontSize="14" Foreground="#788896" 
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="BtnClose_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <!-- Destructive action hover state (Red) -->
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main application content container -->
            <Grid Grid.Row="1">

                <!-- Dynamic radial gradient background -->
                <Rectangle>
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.2,0.2" RadiusX="0.8" RadiusY="0.8">
                            <GradientStop Color="#002A1F" Offset="0" />
                            <GradientStop Color="#0B0F13" Offset="1" />
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Central floating login card -->
                <Border Width="420" Height="530" 
                        Background="#141A21" 
                        CornerRadius="16" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center">

                    <!-- Drop shadow for visual depth -->
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" Color="Black" Opacity="0.5" ShadowDepth="15"/>
                    </Border.Effect>

                    <!-- Top accent line matching the brand color -->
                    <Border BorderThickness="0,4,0,0" BorderBrush="#00C896" CornerRadius="16">

                        <!-- Form content layout with consistent padding -->
                        <StackPanel Margin="45,40,45,40">

                            <!-- Dual-tone typography for the brand name -->
                            <TextBlock HorizontalAlignment="Center" FontSize="38" FontFamily="Segoe UI" Margin="0,0,0,5">
                                <Run Text="NexGen" FontWeight="Light" Foreground="White"/>
                                <Run Text="Sales" FontWeight="Black" Foreground="#00C896"/>
                            </TextBlock>

                            <!-- Application subtitle -->
                            <TextBlock Text="Intelligent Business Companion" FontSize="13" Foreground="#5A6A7A" HorizontalAlignment="Center" Margin="0,0,0,45" />

                            <!-- Username input field -->
                            <TextBlock Text="USERNAME" FontSize="11" FontWeight="Bold" Foreground="#687A8C" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" x:Name="txtUsername" Height="45" FontSize="14" Foreground="White" Background="#1E262E" BorderThickness="1" BorderBrush="#2D3A46" Padding="15,0" VerticalContentAlignment="Center" Margin="0,0,0,18">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <!-- Password input field -->
                            <TextBlock Text="PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#687A8C" Margin="0,0,0,8"/>
                            <PasswordBox x:Name="txtPassword" PasswordChanged="txtPassword_PasswordChanged" Height="45" FontSize="14" Foreground="White" Background="#1E262E" BorderThickness="1" BorderBrush="#2D3A46" Padding="15,0" VerticalContentAlignment="Center" Margin="0,0,0,10">
                                <PasswordBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </PasswordBox.Resources>
                            </PasswordBox>

                            <!-- Password recovery link -->
                            <TextBlock Text="Forgot Password?" FontSize="12" Foreground="#788896" HorizontalAlignment="Right" Cursor="Hand" Margin="0,0,0,25">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#00C896"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Primary login execution button -->
                            <Button Command="{Binding LoginCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Content="LOGIN" IsDefault="True" Click="BtnLogin_Click" Height="48" FontSize="14" FontWeight="Bold" Foreground="White" Cursor="Hand" Margin="0,0,0,15">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#00C896"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#00A87D"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Secondary registration button (Ghost style) -->
                            <Button Command="{Binding NavigateRegisterCommand}" Content="CREATE NEW ACCOUNT" Height="48" FontSize="13" FontWeight="Bold" Foreground="#00C896" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="#00C896" BorderThickness="1.5" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#002A1F"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                        </StackPanel>
                    </Border>
                </Border>

                <!-- Copyright and licensing footer -->
                <TextBlock Text="© 2026 NexGenSales. All rights reserved." 
                           FontSize="12" Foreground="#4A5A6A" 
                           VerticalAlignment="Bottom" HorizontalAlignment="Center" 
                           Margin="0,0,0,20"/>
            </Grid>
        </Grid>
    </Border>
</Window>