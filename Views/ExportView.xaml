<Window x:Class="nexgensales.Views.ExportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexGenSales - Export" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        ResizeMode="CanResize">

    
    <Window.Resources>
        <!-- Custom style for ComboBox to match the dark theme and override default Windows styling -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1C2127"/>
            <Setter Property="Foreground" Value="#D3D9E0"/>
            <Setter Property="BorderBrush" Value="#2D3A46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Main background and border -->
                            <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="6"/>

                            <!-- Toggle button covering the entire combo box for click detection -->
                            <ToggleButton Name="ToggleButton" BorderThickness="0" Background="Transparent" 
                                          Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <!-- Custom teal dropdown arrow -->
                                            <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#00C896" 
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Area where the selected text is displayed -->
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              Margin="{TemplateBinding Padding}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                              HorizontalAlignment="Left"/>

                            <!-- The dropdown popup window -->
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#141A21" BorderBrush="#2D3A46" BorderThickness="1" CornerRadius="6" Margin="0,4,0,0" 
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ComboBox}}}">
                                    <ScrollViewer Margin="0,5">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom style for individual items inside the ComboBox -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#A0ABB5"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="Border" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="4" Margin="4,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2D3A46"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#00C896"/>
                                <Setter Property="Foreground" Value="#0B0F13"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

   
    <Border Background="#0B0F13" CornerRadius="12">
        <Grid>
            <!-- Row 0: Custom Title Bar | Row 1: Application Content -->
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

          
            <!-- CUSTOM TITLE BAR -->
        
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Window_MouseDown">
                <!-- Branding -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock Text="💼" Foreground="#00C896" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="NexGenSales - Export" Foreground="#788896" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="45" Height="35" Content="—" FontSize="12" Foreground="#788896" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnMinimize_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A3642"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Width="45" Height="35" Content="☐" FontSize="14" Foreground="#788896" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnMaximize_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A3642"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Width="45" Height="35" Content="✕" FontSize="14" Foreground="#788896" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

             <Grid Grid.Row="1">

                <!-- Background Gradient -->
                <Rectangle>
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.2,0.2" RadiusX="0.8" RadiusY="0.8">
                            <GradientStop Color="#001F17" Offset="0" />
                            <GradientStop Color="#0B0F13" Offset="1" />
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Analytics Back Button -->
                <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,30,0,0" Height="36" Padding="15,0" Cursor="Hand" Click="BtnBack_Click" Width="83">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#00C896"/>
                            <Setter Property="Foreground" Value="#0B0F13"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#00A87D"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#x276E;" FontWeight="Bold" Margin="0,0,6,0" FontSize="11"/>
                        <TextBlock Text="Analytics" FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                </Button>

               
                <!-- EXPORT FORMS CONTAINER  -->
                
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0">

                    <!-- PARSED DATA SECTION -->
                    <Grid Margin="0,0,0,60">
                        <Grid.ColumnDefinitions>
                            <!-- Fixed width for proper left-side alignment of headings -->
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Heading -->
                        <TextBlock Grid.Column="0" Text="Export Parsed Data" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Top" Margin="0,8,0,0"/>

                        <!-- Form Area -->
                        <StackPanel Grid.Column="1">
                            <!-- Inputs Row -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="Select Date Range" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Width="140"/>

                                <ComboBox Width="170" Margin="0,0,15,0" SelectedIndex="0">
                                    <ComboBoxItem Content="Start Date" />
                                    <ComboBoxItem Content="2026-05-01" />
                                    <ComboBoxItem Content="2026-06-01" />
                                </ComboBox>

                                <ComboBox Width="170" SelectedIndex="0">
                                    <ComboBoxItem Content="End Date" />
                                    <ComboBoxItem Content="2026-05-31" />
                                    <ComboBoxItem Content="2026-06-30" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Export Button -->
                            <Button Content="Export" Width="495" Height="45" FontSize="14" FontWeight="Bold" Foreground="#0B0F13" Cursor="Hand" HorizontalAlignment="Left">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#00C896"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#00A87D"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ANALYTICS SECTION -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Matching column width ensures vertical alignment with the section above -->
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Heading -->
                        <TextBlock Grid.Column="0" Text="Export Analytics" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Top" Margin="0,8,0,0"/>

                        <!-- Form Area -->
                        <StackPanel Grid.Column="1">
                            <!-- Inputs Row -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="Select Report Title" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Width="140"/>

                                <ComboBox Width="170" SelectedIndex="0">
                                    <ComboBoxItem Content="&lt;TITLE 01&gt;" />
                                    <ComboBoxItem Content="Monthly Sales" />
                                    <ComboBoxItem Content="Annual Revenue" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Export Button -->
                            <Button Content="Export" Width="495" Height="45" FontSize="14" FontWeight="Bold" Foreground="#0B0F13" Cursor="Hand" HorizontalAlignment="Left">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#00C896"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#00A87D"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>