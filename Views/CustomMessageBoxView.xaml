<Window x:Class="NexGenSales.Views.CustomMessageBoxView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message" Height="220" Width="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True">

    <Border Background="#141A21" BorderBrush="#1E262E" BorderThickness="1" CornerRadius="12" MouseLeftButtonDown="Window_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Color="Black" Opacity="0.6" ShadowDepth="10"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="65"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,10,0,0">
                <TextBlock Name="TxtIcon" Text="ℹ️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Name="TxtTitle" Text="Notification" Foreground="#D3D9E0" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Name="TxtMessage" Grid.Row="1" Text="Message goes here..." Foreground="#A0ABB5" FontSize="14" TextWrapping="Wrap" Margin="20,15,20,5" VerticalAlignment="Top"/>

            <Border Grid.Row="2" Background="#0B0F13" CornerRadius="0,0,12,12" BorderBrush="#1E262E" BorderThickness="0,1,0,0">
                <Button Name="BtnOk" Content="OK" Width="100" Height="35" HorizontalAlignment="Right" Margin="0,0,20,0" FontSize="13" FontWeight="Bold" Cursor="Hand" Click="BtnOk_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#00C896"/>
                            <Setter Property="Foreground" Value="#0B0F13"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#00A87D"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>