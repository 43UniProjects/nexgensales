<Window x:Class="NexGenSales.Views.HomeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexGenSales - Home" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        ResizeMode="CanResize"
        MinHeight="600" MinWidth="900">
    
    

    <Window.Resources>

        <!-- Custom Style for ComboBox: Applies a dark theme with rounded corners -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1C2127"/>
            <Setter Property="Foreground" Value="#D3D9E0"/>
            <Setter Property="BorderBrush" Value="#2D3A46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
                            <ToggleButton Name="ToggleButton" BorderThickness="0" Background="Transparent" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <!-- Custom Dropdown Arrow -->
                                            <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#00C896" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="Left"/>

                            <!-- Dropdown Popup Configuration -->
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#141A21" BorderBrush="#2D3A46" BorderThickness="1" CornerRadius="6" Margin="0,4,0,0" Width="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ComboBox}}}">
                                    <ScrollViewer Margin="0,5">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Style for ComboBox Items: Handles hover and selection states -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#A0ABB5"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="Border" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="4" Margin="4,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2D3A46"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#00C896"/>
                                <Setter Property="Foreground" Value="#0B0F13"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================================== -->
        <!-- ANIMATION STYLES: Encapsulates reusable visual effects for workflow components -->
        <!-- ============================================================================== -->

        <!-- Base Style for Workflow Cards (Handles shared aesthetics and layout profiles) -->
        <Style TargetType="Border" x:Key="BaseCardStyle">
            <Setter Property="Width" Value="190"/>
            <Setter Property="Height" Value="250"/>
            <Setter Property="Background" Value="#141A21"/>
            <Setter Property="BorderBrush" Value="#1E262E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <!-- Initializes spatial coordinates for structural animations -->
                    <TranslateTransform X="0" Y="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <!-- Default resting shadow profile to create baseline depth -->
                    <DropShadowEffect BlurRadius="25" Color="Black" Opacity="0.4" ShadowDepth="8"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sequential Wave Animation: Card 1 (Starts immediately at 0.0s) -->
        <Style TargetType="Border" x:Key="Card1Style" BasedOn="{StaticResource BaseCardStyle}">
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="-15" KeySpline="0.25,0.1 0.25,1"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0" KeySpline="0.25,0.1 0.25,1"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:13.2" Value="0"/>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)">
                                <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="25"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="45"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="25"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:13.2" Value="25"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>


        <!-- Sequential Wave Animation: Card 2 (Starts at 0.8s) -->
        <Style TargetType="Border" x:Key="Card2Style" BasedOn="{StaticResource BaseCardStyle}">
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                                <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="0"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="-15" KeySpline="0.25,0.1 0.25,1"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0" KeySpline="0.25,0.1 0.25,1"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:13.2" Value="0"/>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)">
                                <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="25"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="45"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="25"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:13.2" Value="25"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Sequential Wave Animation: Card 3 (Starts  at 1.6s) -->
        <Style TargetType="Border" x:Key="Card3Style" BasedOn="{StaticResource BaseCardStyle}">
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                                <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="-15" KeySpline="0.25,0.1 0.25,1"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="0" KeySpline="0.25,0.1 0.25,1"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:13.2" Value="0"/>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)">
                                <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="25"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="45"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:3.2" Value="25"/>
                                <SplineDoubleKeyFrame KeyTime="0:0:13.2" Value="25"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Custom Style for Flow Indicators: Drives a continuous, one-way forward stream animation -->
        <Style TargetType="TextBlock" x:Key="LiveArrowStyle">
            <Setter Property="Text" Value="»"/>
            <Setter Property="FontSize" Value="50"/>
            <Setter Property="Foreground" Value="#00C896"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <!-- Initializes spatial coordinates for horizontal displacement -->
                    <TranslateTransform X="0" Y="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <!-- Animates spatial translation: Moves from left to right seamlessly -->
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                                <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="-20"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="0"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="20"/>
                            </DoubleAnimationUsingKeyFrames>
                            <!-- Animates transparency: Fades in as it enters, fades out as it exits -->
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="0.6"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="0"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================================== -->
        <!-- PROGRESS BAR STYLE: Modern, flat UI progress bar for asynchronous operations   -->
        <!-- ============================================================================== -->
        <Style TargetType="ProgressBar" x:Key="ModernProgressBarStyle">
            <Setter Property="Background" Value="#1C2127"/>
            <Setter Property="Foreground" Value="#00C896"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="4"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ============================================================================== -->
    <!-- MAIN WINDOW LAYOUT: Custom border acts as the primary container                -->
    <!-- ============================================================================== -->
    <Border Background="#0B0F13" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Window_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock Text="💼" Foreground="#00C896" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="NexGenSales - Dashboard" Foreground="#788896" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="45" Height="35" Content="—" FontSize="12" Foreground="#788896" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnMinimize_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A3642"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Width="45" Height="35" Content="☐" FontSize="14" Foreground="#788896" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnMaximize_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A3642"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Width="45" Height="35" Content="✕" FontSize="14" Foreground="#788896" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============================================================================== -->
            <!-- MAIN CONTENT AREA                                                              -->
            <!-- ============================================================================== -->
            <Grid Grid.Row="1">
                <Rectangle>
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                            <GradientStop Color="#001F17" Offset="0" />
                            <GradientStop Color="#0B0F13" Offset="1" />
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,25">
                        <Button Content="&#x276E;  Logout" Click="BtnLogout_Click" HorizontalAlignment="Left" Width="130" Height="40" FontSize="13" Foreground="#A0ABB5" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#1C2127"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="#2D3A46" BorderThickness="1">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E81123"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#E81123"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Process  &#x276F;" Click="BtnGotoProcess_Click" HorizontalAlignment="Right" Width="130" Height="40" FontSize="13" Foreground="#0B0F13" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#00C896"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#00A87D"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- ============================================================== -->
                    <!-- HEADER SECTION: Application Greeting and Descriptive Subtitle  -->
                    <!-- ============================================================== -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,2,0,30">

                        <!-- Main Welcome Title: Utilizes the <Run> tag for inline typography and multi-color formatting -->
                        <TextBlock FontSize="34" HorizontalAlignment="Center" FontFamily="Segoe UI">
                            <Run Text="Welcome to " Foreground="White" FontWeight="Light"/>
                            <Run Text="NexGenSales" Foreground="#00C896" FontWeight="Bold"/>
                        </TextBlock>

                        <!-- Secondary Subtitle: Fills the negative space and provides context for the dashboard -->
                        <TextBlock Text="Streamline your workflow, analyze records, and generate insights effortlessly." 
                                   Foreground="#788896" 
                                   FontSize="15" 
                                   FontWeight="Regular" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,8,0,0"
                                   FontFamily="Segoe UI"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Style="{StaticResource Card1Style}" Margin="0,0,30,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="IMPORT" Foreground="#00C896" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                                <TextBlock Text="RECORDS" Foreground="#00C896" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                                <Image Source="../assets/home/import.png" Width="70" Height="70" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource LiveArrowStyle}" Margin="0,0,30,0"/>

                        <Border Style="{StaticResource Card2Style}" Margin="0,0,30,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="RUN" Foreground="#00C896" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                                <TextBlock Text="ANALYSIS" Foreground="#00C896" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                                <Image Source="../assets/home/analys.png" Width="70" Height="70" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource LiveArrowStyle}" Margin="0,0,30,0"/>

                        <Border Style="{StaticResource Card3Style}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="DONE" Foreground="#00C896" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,50"/>
                                <Image Source="../assets/home/done.png" Width="70" Height="70" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="3" Background="#141A21" BorderBrush="#1E262E" BorderThickness="1" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" Padding="40,25">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.3" ShadowDepth="5"/>
                        </Border.Effect>
                        
                        

                        <StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                                <TextBlock Text="Select Type" Foreground="#788896" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0"/>

                                <ComboBox Width="260" SelectedValue="{Binding SelectedRecordType, Mode=TwoWay}" SelectedValuePath="Content">
                                    <ComboBoxItem Content="Sales Record"/>
                                    <ComboBoxItem Content="Expenses Record"/>
                                    <ComboBoxItem Content="Restore Database"/>
                                </ComboBox>
                            </StackPanel>

                            <Button Command="{Binding ImportRecordCommand}" Height="48" FontSize="14" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#00C896"/>
                                        <Setter Property="Foreground" Value="#0B0F13"/>
                                        <Setter Property="Content" Value="Import Record"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#00A87D"/>
                                            </Trigger>

                                            <DataTrigger Binding="{Binding SelectedRecordType}" Value="Restore Database">
                                                <Setter Property="Content" Value="Restore Selected Database"/>
                                                <Setter Property="Background" Value="#E81123"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding SelectedRecordType}" Value="Restore Database"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="#C20E1C"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                        </StackPanel>
                        
                    </Border>
                </Grid>

                <!-- ============================================================================== -->
                <!-- ASYNCHRONOUS PROGRESS OVERLAY: Blocks UI input and provides real-time feedback -->
                <!-- Displayed securely over the main content when IsImporting == True              -->
                <!-- ============================================================================== -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <!-- Hidden by default -->
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <!-- Activated only during active background processing -->
                                <DataTrigger Binding="{Binding IsImporting}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <!-- Semi-transparent dark curtain to blur background operations -->
                    <Border Background="#E60B0F13"/>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ImportStatusMessage}" 
                                   Foreground="#D3D9E0" FontSize="18" FontWeight="SemiBold" 
                                   HorizontalAlignment="Center" Margin="0,0,0,25" FontFamily="Segoe UI">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                                                     From="1.0" To="0.3" Duration="0:0:0.8">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ProgressBar Value="{Binding ImportProgress}" Minimum="0" Maximum="100" Width="450" Style="{StaticResource ModernProgressBarStyle}"/>

                        <TextBlock Foreground="#00C896" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0" FontFamily="Segoe UI">
                            <Run Text="{Binding ImportProgress}"/>
                            <Run Text="%"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>

    </Border>
    
    
</Window>