<Window x:Class="NextGenSales.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Title="NexGenSales - Home"           
             Background="#151A1E" 
             MinHeight="600" MinWidth="900">

    <!-- Main Grid divided into 4 horizontal sections -->
    <Window.Resources>
        <!-- Style for the ComboBox Dropdown -->
        <Style x:Key="PremiumDarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#1E262E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,0,30,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Main rounded background -->
                            <Border Background="{TemplateBinding Background}"
                        CornerRadius="8"
                        BorderBrush="#2D3A46" BorderThickness="1.5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Selected Text -->
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"/>

                                    <!-- The custom Green Arrow Button -->
                                    <ToggleButton Grid.Column="1" Focusable="False" 
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                      ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Path Data="M 0 0 L 6 6 L 12 0" 
                                              Stroke="#00C896" StrokeThickness="2.5" 
                                              VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <!-- The Popup List (When clicked) -->
                                    <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True">
                                        <Border Background="#1E262E" CornerRadius="8" Margin="0,5,0,0" BorderBrush="#2D3A46" BorderThickness="1">
                                            <StackPanel IsItemsHost="True" Margin="0,5"/>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for ComboBox Items inside the dropdown -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1E262E"/>
            <Setter Property="Foreground" Value="#8B9BAA"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="Border" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover Effect -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2D3A46"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                    <GradientStop Color="#002A1F" Offset="0" />
                    <GradientStop Color="#0B0F13" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 0: Top Bar -->
                <RowDefinition Height="Auto"/>
                <!-- 1: Welcome Title -->
                <RowDefinition Height="*"/>
                <!-- 2: Cards Section (Takes remaining space) -->
                <RowDefinition Height="Auto"/>
                <!-- 3: Bottom Controls -->
            </Grid.RowDefinitions>

            <!-- ROW 0: Top Bar -->
            <Grid Grid.Row="0">
                <Button Content="Goto Process >" HorizontalAlignment="Right" Padding="15,8" 
                        Background="#00C896" Foreground="#0B0F13" FontWeight="Bold" 
                        BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- ROW 1: Welcome Title -->
            <TextBlock Grid.Row="1" Text="Welcome to NexGenSales" 
                       Foreground="#3A4A5A" FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,40,0,0"/>

            <!-- ROW 2: The Three Step Cards -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Card 1: Import Records -->
                <!-- Card 1: Import Records -->
                <!-- Card 1: Import Records -->
                <Border Width="180" Height="240" Background="#1B2228" CornerRadius="15" Margin="0,0,30,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.3" ShadowDepth="5"/>
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="IMPORT" Foreground="#00C896" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock Text="RECORDS" Foreground="#00C896" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                        <Image Source="../assets/home/import.png" Width="65" Height="64" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Arrow -->
                <TextBlock Text="»" FontSize="60" Foreground="#2D3A46" VerticalAlignment="Center" Margin="0,0,30,0"/>

                <!-- Card 2: Run Analysis -->
                <Border Width="180" Height="240" Background="#1B2228" CornerRadius="15" Margin="0,0,30,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.3" ShadowDepth="5"/>
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="RUN" Foreground="#00C896" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock Text="ANALYSIS" Foreground="#00C896" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                        <Image Source="../assets/home/analys.png" Width="65" Height="65" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Arrow -->
                <TextBlock Text="»" FontSize="60" Foreground="#2D3A46" VerticalAlignment="Center" Margin="0,0,30,0"/>

                <!-- Card 3: Done -->
                <Border Width="180" Height="240" Background="#1B2228" CornerRadius="15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.3" ShadowDepth="5"/>
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DONE" Foreground="#00C896" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,45"/>
                        <Image Source="../assets/home/done.png" Width="65" Height="65" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ROW 3: Bottom Controls (Dropdown & Button) -->
            <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">

                <!-- Selection Area -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="Select Record Type" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <ComboBox Width="200" Height="40"
                              Style="{StaticResource PremiumDarkComboBox}"
                              SelectedIndex="0">

                        <ComboBoxItem Content="Sales Record"/>
                        <ComboBoxItem Content="Expenses Record"/>
                    </ComboBox>
                </StackPanel>

                <!-- Big Import Button -->
                <Button Content="Import Record" Width="400" Height="50" 
                        Background="#00C896" Foreground="#0B0F13" FontSize="16" FontWeight="Bold" 
                        BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

            </StackPanel>

        </Grid>
    </Grid>
</Window>