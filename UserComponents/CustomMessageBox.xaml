<Window x:Class="NexGenSales.UserComponents.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message" SizeToContent="WidthAndHeight" Width="400" MinHeight="150"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None"
        BorderBrush="#2D3A46" BorderThickness="1" 
        Background="#0B0F13" Foreground="#D3D9E0">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / Title -->
        <TextBlock Name="txtTitle" Grid.Row="0" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#00C896"/>

        <!-- Message Body -->
        <TextBlock Name="txtMessage" Grid.Row="1" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,20" Foreground="#D3D9E0"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="btnOk" Content="OK" Width="75" Height="28" Margin="5,0,0,0" Click="BtnOk_Click" IsDefault="True">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#1C2127"/>
                        <Setter Property="Foreground" Value="#D3D9E0"/>
                        <Setter Property="BorderBrush" Value="#2D3A46"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#00C896"/>
                                <Setter Property="Foreground" Value="#0B0F13"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Name="btnCancel" Content="Cancel" Width="75" Height="28" Margin="5,0,0,0" Click="BtnCancel_Click" IsCancel="True">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#1C2127"/>
                        <Setter Property="Foreground" Value="#D3D9E0"/>
                        <Setter Property="BorderBrush" Value="#2D3A46"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2D3A46"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
