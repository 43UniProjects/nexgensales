<Window x:Class="NexGenSales.UserComponents.CustomFileOpener"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select a File" Height="450" Width="600"
        WindowStyle="None" WindowStartupLocation="Manual" AllowsTransparency="True" Background="Transparent" Foreground="#D3D9E0">
    <Border Background="#0B0F13" CornerRadius="12" BorderBrush="#2D3A46" BorderThickness="1">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar area allowing window drag functionality -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Window_MouseDown" Margin="-10,-10,-10,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock Text="📁" Foreground="#00C896" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Select a File" Foreground="#788896" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="45" Height="35" Content="✕" FontSize="14" Foreground="#788896" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnCloseTitle_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="0,11,0,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Current Path Display Bar -->
            <TextBox Name="txtCurrentPath" Grid.Row="1" Margin="0,0,0,10" IsReadOnly="True" 
                     Background="#1C2127" Foreground="#D3D9E0" 
                     BorderBrush="#2D3A46" BorderThickness="1" Padding="5"/>

            <!-- Files and Directories Container List -->
            <ListBox Name="lstFileSystem" Grid.Row="2" 
                     Background="#141A21" Foreground="#D3D9E0" 
                     BorderBrush="#2D3A46" BorderThickness="1" MouseDoubleClick="LstFileSystem_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <!-- Icon Anchor placeholder -->
                        <TextBlock Text="{Binding Icon}" Margin="0,0,8,0" Foreground="#00C896"/>
                        <TextBlock Text="{Binding Name}" Foreground="#D3D9E0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Bottom Action Bar -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button Content="Open" Width="80" Height="26" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="BtnOpen_Click" Margin="5,0,0,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#1C2127"/>
                        <Setter Property="Foreground" Value="#D3D9E0"/>
                        <Setter Property="BorderBrush" Value="#2D3A46"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#00C896"/>
                                <Setter Property="Foreground" Value="#0B0F13"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Cancel" Width="80" Height="26" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="BtnCancel_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#1C2127"/>
                        <Setter Property="Foreground" Value="#D3D9E0"/>
                        <Setter Property="BorderBrush" Value="#2D3A46"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2D3A46"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <TextBox Name="txtSelectedFile" 
                     Background="#1C2127" Foreground="#D3D9E0" 
                     BorderBrush="#2D3A46" BorderThickness="1" Padding="4" IsReadOnly="True"/>
        </DockPanel>
    </Grid>
    </Border>
</Window>
